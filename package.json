{
	"name": "pdm",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "node e2e/setup-test-db.mjs && playwright test",
		"test:coverage": "vitest --run --project server --coverage",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:pull": "drizzle-kit pull",
		"db:drop": "drizzle-kit drop",
		"db:up": "supabase start",
		"db:down": "supabase stop",
		"logging:up": "docker-compose up -d postgres-exporter loki promtail grafana prometheus node-exporter",
		"logging:down": "docker-compose down postgres-exporter loki promtail grafana prometheus node-exporter",
		"logging:logs": "docker-compose logs -f postgres-exporter loki promtail grafana prometheus",
		"logging:restart": "docker-compose restart postgres-exporter loki promtail grafana prometheus node-exporter",
		"monitoring:up": "docker-compose up -d prometheus node-exporter grafana",
		"monitoring:down": "docker-compose down prometheus node-exporter grafana",
		"monitoring:logs": "docker-compose logs -f prometheus node-exporter",
		"docker:up": "docker-compose up -d",
		"docker:down": "docker-compose down",
		"docker:logs": "docker-compose logs -f",
		"docker:clean": "docker-compose down -v --remove-orphans"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^24.2.0",
		"@vitest/browser": "^3.2.7",
		"@vitest/coverage-v8": "3.2.7",
		"drizzle-kit": "^0.31.4",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"playwright": "^1.53.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"sass": "^1.89.2",
		"svelte": "^5.56.6",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.3.6",
		"vitest": "^3.2.7",
		"vitest-browser-svelte": "^0.1.0"
	},
	"lint-staged": {
		"*.{js,mjs,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,scss,css,html,yml,yaml}": "prettier --write"
	},
	"resolutions": {
		"**/vite": "7.3.6",
		"**/ws": "8.21.1",
		"**/rollup": "4.62.2",
		"**/immutable": "5.1.9",
		"**/flatted": "3.4.2",
		"**/postcss": "8.5.19",
		"**/js-yaml": "4.3.0",
		"**/eslint/minimatch": "3.1.5",
		"**/@eslint/config-array/minimatch": "3.1.5",
		"**/@eslint/eslintrc/minimatch": "3.1.5",
		"**/@typescript-eslint/typescript-estree/minimatch": "9.0.9",
		"**/glob/minimatch": "9.0.9",
		"**/micromatch/picomatch": "2.3.2",
		"**/tinyglobby/picomatch": "4.0.5",
		"**/vite/picomatch": "4.0.5",
		"**/vitest/picomatch": "4.0.5",
		"**/@esbuild-kit/core-utils/esbuild": "0.25.11",
		"**/@sveltejs/kit/cookie": "0.7.2"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1068.0",
		"@aws-sdk/s3-request-presigner": "^3.1068.0",
		"@mdi/js": "^7.4.47",
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/encoding": "^1.1.0",
		"@tiptap/core": "^3.26.0",
		"@tiptap/extension-placeholder": "^3.26.0",
		"@tiptap/pm": "^3.26.0",
		"@tiptap/starter-kit": "^3.26.0",
		"arctic": "^3.7.0",
		"dotenv": "^17.2.1",
		"drizzle-orm": "^0.45.2",
		"emoji-picker-element": "^1.29.1",
		"music-metadata": "^11.16.0",
		"ogl": "^1.0.11",
		"postgres": "^3.4.7",
		"prom-client": "^15.1.0"
	}
}
